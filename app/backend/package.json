{
  "name": "impreideas-backend",
  "version": "1.0.0",
  "description": "Backend Node.js para ImpreIdeas - Sistema de merchandising corporativo",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
